{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ai-journal-mcp hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__ai-journal-mcp__add_entry",
        "hooks": [
          {
            "type": "command",
            "command": "ai-journal-mcp hook",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ai-journal-mcp hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
